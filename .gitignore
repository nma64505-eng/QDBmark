# Keep required offline dependency archives used by Dockerfile.
!tools/benchmarksql-oceanbase-master.tar.gz
!tools/benchmarksql-oceanbase-src.tar.gz
!tools/hammerdb-oracle-sqlserver-cache/*.tar.gz
!tools/instantclient-oracle-cache/*.zip
!tools/swingbench-oracle-cache/*.zip
!tools/benchmarksql-dm-cache/
!tools/benchmarksql-dm-cache/README.md
tools/benchmarksql-dm-cache/*.tar
tools/benchmarksql-dm-cache/*.tar.gz

# BenchmarkSQL / benchmark generated outputs
.jTPCC_run_seq.dat
.wh.*
tools/**/run/dameng_result_*/
tools/**/run/result_*/
tools/**/run/results/
tools/**/run/output/

# Tool build output that can be regenerated
tools/**/build/
tools/**/target/

# Extracted runtime tool directories with generated keys/certs.
tools/benchmarksql-dm/
