# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# OS/editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Runtime data generated by QDBmark
/data/
/reports/
/artifacts/
/uploads/
